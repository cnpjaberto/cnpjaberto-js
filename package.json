{
  "name": "cnpjaberto",
  "version": "0.2.0",
  "description": "SDK em TypeScript e servidor MCP para o cnpjaberto.com.br, cadastro aberto de empresas brasileiras (CNPJ).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "cnpjaberto-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test:smoke": "npm run build && node examples/basic.mjs",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/*.{ts,mjs}\" \"examples/*.{ts,mjs,json}\" README.md \"tsconfig*.json\" package.json \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/*.{ts,mjs}\" \"examples/*.{ts,mjs,json}\" README.md \"tsconfig*.json\" package.json \".github/workflows/*.yml\""
  },
  "keywords": [
    "cnpj",
    "brasil",
    "receita-federal",
    "mcp",
    "claude",
    "model-context-protocol",
    "sdk"
  ],
  "author": "CNPJ Aberto <contato@cnpjaberto.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnpjaberto/cnpjaberto-js.git"
  },
  "homepage": "https://cnpjaberto.github.io/cnpjaberto-js/",
  "bugs": {
    "url": "https://github.com/cnpjaberto/cnpjaberto-js/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
